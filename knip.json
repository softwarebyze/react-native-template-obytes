{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/*.{tsx,ts}",
    "src/components/ui/index.tsx",
    "src/components/ui/icons/index.tsx",
    "src/lib/i18n/index.tsx",
    "src/lib/storage.tsx",
    "env.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/components/ui/form-utils.ts",
    "src/components/ui/modal-keyboard-aware-scroll-view.tsx",
    "src/lib/utils.ts",
    "src/lib/web-share-meta.ts",
    "src/lib/haptics.ts",
    "src/lib/app-links.ts"
  ],
  "ignoreBinaries": [
    "adb",
    "xed",
    "eas",
    "maestro",
    "skills",
    "fastlane"
  ],
  "ignoreDependencies": [
    "husky",
    "babel-preset-expo",
    "expo-crypto",
    "react-native-url-polyfill",
    "react-error-boundary",
    "@tailwindcss/cli",
    "@types/i18n-js",
    "@types/invariant",
    "dotenv",
    "eslint-plugin-unicorn",
    "zustand",
    "sharp",
    "expo-updates",
    "expo-haptics",
    "posthog-react-native",
    "agent-device",
    "expo-application",
    "expo-device"
  ]
}

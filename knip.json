{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/*.{tsx,ts}",
    "src/components/ui/index.tsx",
    "src/components/ui/icons/index.tsx",
    "src/lib/i18n/index.tsx",
    "src/lib/storage.tsx",
    "env.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "src/components/ui/form-utils.ts",
    "src/components/ui/modal-keyboard-aware-scroll-view.tsx",
    "src/lib/utils.ts"
  ],
  "ignoreBinaries": [
    "adb",
    "xed",
    "eas",
    "maestro",
    "skills",
    "fastlane"
  ],
  "ignoreDependencies": [
    "husky",
    "babel-preset-expo",
    "expo-crypto",
    "react-native-url-polyfill",
    "react-error-boundary",
    "@tailwindcss/cli",
    "@types/i18n-js",
    "@types/invariant",
    "dotenv",
    "eslint-plugin-unicorn",
    "zustand",
    "@expo/vector-icons",
    "@tanstack/zod-form-adapter",
    "expo-status-bar",
    "@react-navigation/native-stack",
    "@react-navigation/elements",
    "expo-updates",
    "sharp",
    "agent-device"
  ],
  "ignoreIssues": {
    "src/features/auth/use-auth-store.tsx": ["exports"],
    "src/lib/api/provider.tsx": ["exports"],
    "src/lib/api/utils.tsx": ["exports", "types"],
    "src/features/auth/components/login-form.tsx": ["types"]
  }
}
